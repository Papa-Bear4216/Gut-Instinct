## Part 2: AI-Powered Workflow Suggestion Engine (Weeks 3â€“5)

### Goal
**Analyze observation patterns to suggest automation shortcuts.** "User opens Gmail, selects an address, opens Mapsâ€”suggest a workflow that does this in one tap."

### 2.1 Pattern Recognition (Cloud Function)

```typescript
// functions/src/ai/workflowSuggest.ts
import { onSchedule } from 'firebase-functions/v2/scheduler';

interface Pattern {
  apps: string[];          // Sequence of app launches
  actions: string[];       // Text selections, URL opens
  frequency: number;       // Times this pattern was observed
  timeDelta: number[];     // Seconds between each step
  lastSeen: Date;
}

export const workflowSuggest = onSchedule('every 12 hours', async (context) => {
  const db = admin.firestore();
  
  // Fetch all users
  const users = await db.collection('workflows').select('uid').get();
  const uids = new Set(users.docs.map(d => d.data().uid));
  
  for (const uid of uids) {
    await suggestForUser(db, uid);
  }
});

async function suggestForUser(db: FirebaseFirestore, uid: string) {
  // 1. Fetch last 7 days of observations
  const cutoff = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();
  const obs = await db.collection('observations')
    .where('uid', '==', uid)
    .where('timestamp', '>', cutoff)
    .orderBy('timestamp')
    .limit(1000)
    .get();
  
  const observations = obs.docs.map(d => d.data() as Observation);
  
  // 2. Find repeating patterns (sliding window)
  const patterns = identifyPatterns(observations);
  
  // 3. For each pattern, generate a workflow suggestion via Gemini
  for (const pattern of patterns) {
    if (pattern.frequency < 3) continue;  // Only suggest patterns seen 3+ times
    
    const suggestion = await generateSuggestion(uid, pattern, observations);
    
    // 4. Store suggestion in Firestore
    await db.collection('suggestions').add({
      uid,
      observationIds: pattern.observationIds,
      proposedWorkflow: suggestion.workflow,
      reasoning: suggestion.reasoning,
      confidence: suggestion.confidence,
      userApproved: false,
      createdAt: new Date().toISOString(),
      expiresAt: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString(),  // 30 days
    });
  }
}

function identifyPatterns(observations: Observation[]): Pattern[] {
  const patterns: Map<string, Pattern> = new Map();
  
  // Sliding window: look for repeated sequences
  for (let i = 0; i < observations.length - 2; i++) {
    const window = [observations[i], observations[i + 1], observations[i + 2]];
    const key = window.map(o => o.appInForeground).join('â†’');
    const timeDelta = [
      new Date(window[1].timestamp).getTime() - new Date(window[0].timestamp).getTime(),
      new Date(window[2].timestamp).getTime() - new Date(window[1].timestamp).getTime(),
    ];
    
    if (!patterns.has(key)) {
      patterns.set(key, {
        apps: window.map(o => o.appInForeground),
        actions: window.flatMap(o => o.selectedText ? [o.selectedText] : []),
        frequency: 0,
        timeDelta,
        lastSeen: new Date(window[2].timestamp),
        observationIds: [],  // Track which obs led to this pattern
      });
    }
    
    const p = patterns.get(key)!;
    p.frequency++;
    p.observationIds.push(...window.map((_, idx) => observations[i + idx].id!));
  }
  
  return Array.from(patterns.values()).filter(p => p.frequency >= 3);
}

async function generateSuggestion(
  uid: string,
  pattern: Pattern,
  allObservations: Observation[]
): Promise<{ workflow: Workflow; reasoning: string; confidence: number }> {
  const genai = new GoogleGenerativeAI(process.env.GOOGLE_GENAI_API_KEY!);
  const model = genai.getGenerativeModel({ model: 'gemini-1.5-flash' });
  
  const prompt = `
You are a workflow automation expert. Analyze this user's app usage pattern and suggest a single Workflow that automates it.

Pattern observed:
- Apps opened in sequence: ${pattern.apps.join(' â†’ ')}
- Average time between steps: ${pattern.timeDelta.map(t => (t / 1000).toFixed(1) + 's').join(', ')}
- User text selections: ${pattern.actions.join(', ')}
- Pattern frequency (last 7 days): ${pattern.frequency} times

Based on this, suggest a single Workflow (automation shortcut) that would save this user time. 

The workflow should:
1. Have a clear trigger (e.g., "Open Gmail" or "Select text in Gmail")
2. Define 2-5 concrete actions (e.g., "Copy selected text", "Open Google Maps", "Fill search field with clipboard")
3. Be simple enough to execute reliably on an Android device

Return a JSON object with this exact structure:
{
  "workflow": {
    "name": "Brief workflow name",
    "description": "One-sentence description of what this does",
    "trigger": {
      "type": "on_app_open" | "on_text_select" | "on_manual",
      "details": { "appPackage": "...", ... }
    },
    "actions": [
      {
        "type": "open_app" | "copy_to_clipboard" | "paste_from_clipboard" | "fill_form" | ...,
        "params": { "appPackage": "...", "value": "...", ... }
      },
      ...
    ]
  },
  "reasoning": "2-3 sentences explaining why this workflow matches the observed pattern",
  "confidence": 0.6 to 0.95
}
  `;
  
  const response = await model.generateContent(prompt);
  const text = response.response.text();
  
  // Extract JSON from response (handle markdown formatting)
  const json = JSON.parse(text.match(/\{[\s\S]*\}/)?.[0] || '{}');
  
  return {
    workflow: {
      ...json.workflow,
      uid,
      enabled: false,  // User must enable manually
      isAiGenerated: true,
      confidenceScore: json.confidence,
      executionCount: 0,
      source: 'ai_generated',
      tags: ['ai_suggested', 'pattern_detected'],
    },
    reasoning: json.reasoning,
    confidence: json.confidence,
  };
}
```

