### 1.2 Observation Ingestion API (Cloud Function)

```typescript
// functions/src/ingest/observationIngest.ts
import { onRequest } from 'firebase-functions/v2/https';

interface ObservationPayload {
  appInForeground: string;
  screenTitle: string;
  selectedText?: string;
  contextMetadata: Record<string, any>;
}

export const observationIngest = onRequest(async (req, res) => {
  let uid: string;
  try {
    uid = await verifyIdToken(req.headers.authorization);
  } catch (e) {
    res.status(401).json({ error: 'Unauthorized' });
    return;
  }
  
  if (!isValidObservationBody(req.body)) {
    res.status(400).json({ error: 'Invalid body' });
    return;
  }
  
  const body: ObservationPayload = req.body;
  const db = admin.firestore();
  const now = new Date().toISOString();
  
  // Batch observations to avoid Firestore write limits (50 writes/sec per user).
  // Store in a staging collection; a background job merges them into observations every minute.
  await db.collection('observationBatch').add({
    uid,
    ...body,
    receivedAt: now,
  });
  
  res.status(200).json({ ok: true });
});

// functions/src/scheduled/mergeObservations.ts
// Run every 2 minutes
export const mergeObservations = onSchedule('every 2 minutes', async (context) => {
  const db = admin.firestore();
  const cutoff = Date.now() - 120000;  // 2 minutes ago
  
  const batch = await db.collection('observationBatch')
    .where('receivedAt', '<', new Date(cutoff).toISOString())
    .limit(500)
    .get();
  
  const writeBatch = db.batch();
  
  batch.docs.forEach(doc => {
    const data = doc.data();
    writeBatch.set(db.collection('observations').doc(), {
      ...data,
      timestamp: data.receivedAt,
      createdAt: data.receivedAt,
      windowHours: 1,
      source: 'native_accessibility_monitor',
    });
    writeBatch.delete(doc.ref);
  });
  
  await writeBatch.commit();
});
```

